@page "/profesores"
@using System.ComponentModel.DataAnnotations
@inject IProfesorApiService ProfesorApiService

<PageTitle>Profesores</PageTitle>

<div class="container py-4 profesores-page">
    <h4 class="mb-3">Profesores</h4>

    <div class="mb-3 action-bar">
        <button class="btn-icon-circle" title="Refrescar" @onclick="RefrescarAsync">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
        <button class="btn-icon-circle" title="Editar"
                disabled="@(!profesorSeleccionadoId.HasValue)" @onclick="AbrirModalEditar">
            <i class="bi bi-pencil"></i>
        </button>
        <button class="btn-icon-circle" title="Eliminar"
                disabled="@(!profesorSeleccionadoId.HasValue)" @onclick="AbrirConfirmarEliminar">
            <i class="bi bi-trash"></i>
        </button>
        <button class="btn-icon-circle" title="Crear" @onclick="AbrirModalCrear">
            <i class="bi bi-plus-lg"></i>
        </button>
    </div>

    <div class="panel-card">
        <div class="panel-header">Profesores</div>
        <table class="table table-panel align-middle mb-0">
            <thead>
                <tr>
                    <th class="col-id">
                        <div class="col-header-stack">
                            <span class="col-header-label">Id</span>
                            <input type="number" class="form-control form-control-sm col-search-input" @bind="filtroId" @bind:event="oninput"
                                   @bind:after="BuscarAsync" />
                        </div>
                    </th>
                    <th class="col-divider">
                        <div class="col-header-stack">
                            <span class="col-header-label">Nombre</span>
                            <input class="form-control form-control-sm col-search-input" @bind="filtroNombre" @bind:event="oninput"
                                   @bind:after="BuscarAsync" />
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (cargando)
                {
                    <tr>
                        <td colspan="2" class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-dark" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </td>
                    </tr>
                }
                else if (profesores is null || profesores.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="text-muted text-center py-4">No se encontraron profesores.</td>
                    </tr>
                }
                else
                {
                    @foreach (var profesor in profesores)
                    {
                        <tr class="@(profesorSeleccionadoId == profesor.Id ? "table-active" : "")"
                            @onclick="() => profesorSeleccionadoId = profesor.Id">
                            <td>@profesor.Id</td>
                            <td>@profesor.Nombre</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="panel-footer d-flex align-items-center">
            <div class="d-flex justify-content-start" style="width: 33%;">
                <span>Registros encontrados: @(profesores?.MetaData.TotalCount ?? 0)</span>
            </div>
            <div class="d-flex justify-content-center flex-grow-1">
                @if (!cargando && profesores is not null && profesores.Count > 0)
                {
                    <div class="d-flex align-items-center gap-2">
                        <ul class="pagination pagination-teal mb-0">
                            <li class="page-item @(profesores.MetaData.HasPrevious ? "" : "disabled")">
                                <button class="page-link" @onclick="() => CambiarPaginaAsync(profesores.MetaData.CurrentPage - 1)">Anterior</button>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link" style="white-space: nowrap;">Página @profesores.MetaData.CurrentPage de @profesores.MetaData.TotalPages</span>
                            </li>
                            <li class="page-item @(profesores.MetaData.HasNext ? "" : "disabled")">
                                <button class="page-link" @onclick="() => CambiarPaginaAsync(profesores.MetaData.CurrentPage + 1)">Siguiente</button>
                            </li>
                        </ul>
                        <select class="form-select form-select-sm" style="width: auto;"
                                @bind="tamanoPagina" @bind:after="BuscarAsync">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="20">20</option>
                        </select>
                    </div>
                }
            </div>
            <div style="width: 33%;"></div>
        </div>
    </div>

    <div class="d-flex justify-content-center gap-4 mt-3">
        <div class="form-check">
            <input class="form-check-input" type="radio" name="estadoFiltro" id="radioActivo"
                   checked="@(!mostrarInactivos)" @onchange="() => CambiarEstadoAsync(false)" />
            <label class="form-check-label" for="radioActivo">Activo</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="estadoFiltro" id="radioInactivo"
                   checked="@(mostrarInactivos)" @onchange="() => CambiarEstadoAsync(true)" />
            <label class="form-check-label" for="radioInactivo">Inactivo</label>
        </div>
    </div>
</div>

@if (mostrarModalForm)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="formModel" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(esEdicion ? "Editar profesor" : "Crear profesor")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModalForm"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="formModel.Nombre" placeholder="Nombre del profesor" />
                        <ValidationMessage For="() => formModel.Nombre" class="text-danger small mt-1 d-block" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModalForm">Cancelar</button>
                        <button type="submit" class="btn btn-dark" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Aceptar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (mostrarConfirmarEliminar)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar profesor</h5>
                    <button type="button" class="btn-close" @onclick="CerrarConfirmarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que deseas eliminar este profesor?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CerrarConfirmarEliminar">Cancelar</button>
                    <button class="btn btn-dark" @onclick="ConfirmarEliminarAsync" disabled="@guardando">
                        @(guardando ? "Eliminando..." : "Aceptar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<Toast Visible="mostrarToast" IsError="toastEsError" Message="@toastMensaje" OnClose="() => mostrarToast = false" />

@code {
    private PagedList<ProfesorRequest>? profesores;
    private string filtroNombre = string.Empty;
    private int? filtroId;
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private bool mostrarInactivos;
    private bool cargando = true;

    private int? profesorSeleccionadoId;

    private bool mostrarModalForm;
    private bool esEdicion;
    private int? idEnEdicion;
    private ProfesorFormModel formModel = new();
    private bool guardando;

    private bool mostrarConfirmarEliminar;

    private bool mostrarToast;
    private bool toastEsError;
    private string toastMensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        try
        {
            var parameters = new ProfesorParameters
            {
                Nombre = string.IsNullOrWhiteSpace(filtroNombre) ? null : filtroNombre,
                Id = filtroId,
                PageNumber = paginaActual,
                PageSize = tamanoPagina,
                SoloInactivos = mostrarInactivos
            };

            profesores = await ProfesorApiService.GetProfesoresAsync(parameters);
        }
        catch (ApiException ex)
        {
            MostrarToast(ex.Message, esError: true);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarAsync()
    {
        paginaActual = 1;
        profesorSeleccionadoId = null;
        await CargarAsync();
    }

    private async Task RefrescarAsync()
    {
        filtroNombre = string.Empty;
        filtroId = null;
        paginaActual = 1;
        profesorSeleccionadoId = null;
        await CargarAsync();
    }

    private async Task CambiarPaginaAsync(int nuevaPagina)
    {
        paginaActual = nuevaPagina;
        profesorSeleccionadoId = null;
        await CargarAsync();
    }

    private async Task CambiarEstadoAsync(bool inactivos)
    {
        mostrarInactivos = inactivos;
        await BuscarAsync();
    }

    private void AbrirModalCrear()
    {
        esEdicion = false;
        idEnEdicion = null;
        formModel = new ProfesorFormModel();
        mostrarModalForm = true;
    }

    private void AbrirModalEditar()
    {
        var profesor = profesores?.FirstOrDefault(p => p.Id == profesorSeleccionadoId);
        if (profesor is null) return;

        esEdicion = true;
        idEnEdicion = profesor.Id;
        formModel = new ProfesorFormModel { Nombre = profesor.Nombre };
        mostrarModalForm = true;
    }

    private void CerrarModalForm()
    {
        mostrarModalForm = false;
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        try
        {
            if (esEdicion && idEnEdicion.HasValue)
            {
                await ProfesorApiService.UpdateProfesorAsync(idEnEdicion.Value, new UpdateProfesorRequest(formModel.Nombre));
                MostrarToast("Profesor actualizado correctamente.", esError: false);
            }
            else
            {
                await ProfesorApiService.CreateProfesorAsync(new CreateProfesorRequest(formModel.Nombre));
                MostrarToast("Profesor creado correctamente.", esError: false);
            }

            mostrarModalForm = false;
            profesorSeleccionadoId = null;
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            MostrarToast(ex.Message, esError: true);
        }
        finally
        {
            guardando = false;
        }
    }

    private void AbrirConfirmarEliminar()
    {
        mostrarConfirmarEliminar = true;
    }

    private void CerrarConfirmarEliminar()
    {
        mostrarConfirmarEliminar = false;
    }

    private async Task ConfirmarEliminarAsync()
    {
        if (!profesorSeleccionadoId.HasValue) return;

        guardando = true;
        try
        {
            await ProfesorApiService.DeleteProfesorAsync(profesorSeleccionadoId.Value);
            MostrarToast("Profesor eliminado correctamente.", esError: false);

            mostrarConfirmarEliminar = false;
            profesorSeleccionadoId = null;
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            MostrarToast(ex.Message, esError: true);
            mostrarConfirmarEliminar = false;
        }
        finally
        {
            guardando = false;
        }
    }

    private void MostrarToast(string mensaje, bool esError)
    {
        toastMensaje = mensaje;
        toastEsError = esError;
        mostrarToast = true;
    }

    private class ProfesorFormModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no puede superar los 100 caracteres.")]
        public string Nombre { get; set; } = string.Empty;
    }
}